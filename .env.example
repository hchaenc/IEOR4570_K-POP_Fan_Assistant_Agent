WEVERSE_ACCESS_TOKEN=your_weverse_access_token
WEVERSE_REFRESH_TOKEN=your_weverse_refresh_token
WEVERSE_DEVICE_ID=your_device_uuid
TICKETMASTER_API_KEY=your_ticketmaster_consumer_key

# Which GCP project pays for Vertex AI calls. gcloud bills the *quota project*,
# not the account that logged in, so do NOT reuse someone else's project ID.
# Resolution order: --gcp-project  >  GOOGLE_CLOUD_PROJECT  >  gcp-project.txt
# Prefer the plain text file gcp-project.txt next to the repository (same place
# as password.txt) so each person keeps their own project out of .env and Git.
# Set this variable only for deployment, where the file is not present.
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# Local only: enables /bench, the direct tool test page.
KPOP_DEBUG_UI=1

# Weverse client identifiers: values the weverse.io web bundle ships to every
# browser, but configuration all the same, so they live here. See docs/TOOLS.md.
WEVERSE_HMAC_ACTIVE_KEY=weverse_gateway_hmac_key
WEVERSE_APP_ID=weverse_client_app_id
WEVERSE_APP_SECRET=weverse_account_api_secret
